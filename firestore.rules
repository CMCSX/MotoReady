rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Matches the user profile document (e.g. /users/default_user)
    match /users/{userId} {
      allow read, write: if true;
      
      // Matches the user's rides subcollection
      match /rides/{rideId} {
        allow read, write: if true;
      }
      
      // Matches the user's parking locations subcollection
      match /parking_locations/{parkingId} {
        allow read, write: if true;
      }
    }
  }
}